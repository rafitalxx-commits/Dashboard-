ODOO_URL=https://example.odoo.com
ODOO_DATABASE=database_name
ODOO_USERNAME=readonly@example.com
ODOO_API_KEY=replace-with-api-key
ODOO_WRITE_ENABLED=false
DASHBOARD_AUTO_LOCATION_MOVEMENTS=false
ODOO_WRITE_USERNAME=readonly-write-disabled@example.com
ODOO_WRITE_API_KEY=replace-only-when-approved
GOOGLE_CALENDAR_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_CALENDAR_REDIRECT_URI=https://dashboard.todoelectrico.net/oauth2/callback
GOOGLE_CALENDAR_TIME_ZONE=Europe/Madrid
AMAZON_MESSAGES_AGENT_DRAFT_WORKER_ENABLED=false
AMAZON_MESSAGES_AGENT_DRAFT_WORKER_INTERVAL_MS=15000

# Incidencias LAB: leave writes disabled until authorized end-to-end validation.
INCIDENTS_SHEETS_WRITE_ENABLED=false
INCIDENTS_DRIVE_WRITE_ENABLED=false
INCIDENTS_ODOO_WRITE_ENABLED=false
# Dedicated Odoo demo connection. No fallback to ODOO_* production settings.
# Do not enable writes until target isolation and the planned test are verified.
INCIDENTS_ODOO_URL=
INCIDENTS_ODOO_DATABASE=odoo-todoelectrico18-demo-01
INCIDENTS_ODOO_USERNAME=
INCIDENTS_ODOO_API_KEY=
INCIDENTS_SPREADSHEET_ID=
INCIDENTS_GOOGLE_ACCOUNT=todoelectrico.es@gmail.com
INCIDENTS_GOOGLE_TOKENS_PATH=/root/.openclaw/secrets/incidents-google-tokens.json
INCIDENTS_GOOGLE_CLIENT_PATH=/root/.openclaw/secrets/incidents-google-client.json
INCIDENTS_DRIVE_ROOT_ID=
# Optional existing ledger directory, read-only. Never change LAB DASHBOARD_DATA_DIR to production.
INCIDENTS_LEDGER_DATA_DIR=

# Explicit opt-in: all incident catalog/order/image/statistics reads use TEST only.
INCIDENTS_ODOO_READ_ENABLED=false
# Server-owned one-operation approval; never set from a browser request.
INCIDENTS_ODOO_APPROVED_DIGEST=
INCIDENTS_ODOO_APPROVED_OPERATION=

# Incidents operational REX: reuses Dashboard ODOO_URL/DATABASE/USERNAME/API_KEY.
# Dedicated write scope: staged REX creation + validation only after verified Dashboard label.
# It does NOT enable generic ODOO_WRITE_ENABLED or stock corrections/receipts.
INCIDENTS_ODOO_MODE=test
INCIDENTS_REX_WRITE_ENABLED=false

# Etiqueta simulada REX: exclusiva DEMO, requiere aprobación exacta temporal.
INCIDENTS_DEMO_LABEL_ENABLED=false

# Automatic DEV/REX registration only. Production remains disabled until separately approved.
INCIDENTS_DOCUMENTS_WRITE_ENABLED=false

# Production Incidencias: separate opt-in; never enables generic Odoo writes.
INCIDENTS_OPERATIONAL_WORKFLOW_ENABLED=false
INCIDENTS_DATA_DIR=
